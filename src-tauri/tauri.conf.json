{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotly",
  "version": "0.1.6",
  "identifier": "com.shotly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shotly 设置",
        "url": "index.html?win=settings",
        "width": 720,
        "height": 780,
        "minWidth": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "copyright": "Shotly",
    "category": "Productivity",
    "shortDescription": "轻量级跨平台截图工具",
    "longDescription": "截图 · 标注 · 识别文字 · 翻译 · 贴图。基于 Tauri 2，包体小、启动快、常驻内存低。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
